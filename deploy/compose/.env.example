# OSCAL Hub - Docker Compose environment file
# Copy this file to `.env` and fill in the required values.
#
#   cp .env.example .env
#   vi .env       # set DB_PASSWORD, JWT_SECRET, PUBLIC_ORIGIN
#   docker compose up -d

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Public URL users will hit in their browser (used for CORS).
# Examples: https://oscal.example.com   |   http://localhost
PUBLIC_ORIGIN=https://oscal.example.com

# Database password. Generate one:  openssl rand -base64 32 | tr -d '\n'
DB_PASSWORD=changeme-please

# JWT signing secret. Generate one:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=changeme-please

# ---------------------------------------------------------------------------
# OPTIONAL — sensible defaults below; uncomment to override
# ---------------------------------------------------------------------------

# Pre-built image. Leave commented to build from source via the local Dockerfile.
# OSCAL_HUB_IMAGE=ghcr.io/your-org/oscal-hub:latest

# Database connection details
# DB_NAME=oscal
# DB_USERNAME=oscal

# JWT token lifetime in milliseconds (default: 1 hour)
# JWT_EXPIRATION=3600000

# Reverse-proxy ports (defaults: 80 / 443)
# HTTP_PORT=80
# HTTPS_PORT=443

# When TLS is terminated upstream (e.g. cloud load balancer), set to false.
# SECURITY_REQUIRE_HTTPS=true

# JVM tuning
# JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75 -XX:+UseG1GC

# Log levels
# LOG_LEVEL_ROOT=WARN
# LOG_LEVEL_OSCAL=INFO

# ---------------------------------------------------------------------------
# OBJECT STORAGE (optional)
# Default = local filesystem inside the container, persisted to a Docker volume.
# Set STORAGE_PROVIDER to s3, gcs, or azure to use external object storage.
# ---------------------------------------------------------------------------

# STORAGE_PROVIDER=azure   # azure | s3 | gcs   (default: azure → local fallback)

# --- Azure Blob Storage ---
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
# AZURE_STORAGE_CONTAINER_NAME=oscal-files

# --- AWS S3 (or S3-compatible like MinIO) ---
# AWS_REGION=us-east-1
# AWS_S3_BUCKET_BUILD=oscal-files
# AWS_ACCESS_KEY_ID=...        # only if not using instance role
# AWS_SECRET_ACCESS_KEY=...
